.venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
dist/
build/

# Datasets are downloaded, not vendored -- each config carries its download command.
data/
saved/

# codecarbon's own scratch file. The numbers worth keeping are folded into results/.
emissions.csv

# Run logs live next to the results they produced; only the results are tracked.
results/*.log

# The exclusivity lock (see green_rerank/measure/guards.py). Machine-local state, and
# the sweep writes one per results directory.
results/.measure.lock
results/**/.measure.lock

# The plumbing config disables the busy-machine abort and stamps every row
# `trustworthy=False`. Its output proves the driver runs; it is not a measurement, and
# it must not sit in the repository beside directories that are.
results/plumbing/

# results/ is deliberately NOT ignored: the CSVs and figures are the point of the
# repository, and a reader should see the numbers without a rerun. They are kilobytes.

.vscode/
.idea/
.DS_Store
.coverage
.coverage.*
htmlcov/
.ruff_cache/
